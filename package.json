{
  "name": "company-brain",
  "version": "0.1.0",
  "description": "A long-term sync hub that checks your company's data sources into Git as searchable files, so an AI agent has durable context.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint",
    "notion:sync": "bun run src/connectors/notion/sync.ts",
    "web:sync": "bun run src/connectors/web/sync.ts",
    "repo:sync": "bun run src/connectors/repo/sync.ts",
    "zendesk:sync": "bun run src/connectors/zendesk/sync.ts",
    "granola:sync": "bun run src/connectors/granola/sync.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "lefthook": "^2.1.9",
    "oxlint": "^1.68.0",
    "prettier": "^3.8.3",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@notionhq/client": "^5.22.0",
    "gray-matter": "^4.0.3",
    "turndown": "^7.2.4"
  }
}
