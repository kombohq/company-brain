# Copy this file to `.env` and fill in the values you need.
# Bun loads `.env` from the project root automatically.
#
# Each connector documents the variables it requires here as it is introduced.

# --- Notion ---
# Internal integration token (https://www.notion.com/my-integrations) with the
# "Read content" and "Read user information including email addresses"
# capabilities. Share the top-level pages/databases you want synced with it.
NOTION_TOKEN=

# --- Repository ---
# Mirror another Git repository into context/. REPO_URL is "owner/name" or a full
# clone URL. REPO_TOKEN is only needed for private repos: create a fine-grained PAT
# at https://github.com/settings/personal-access-tokens/new scoped to just the
# source repo with "Contents: Read-only" (nothing else). REPO_REF and REPO_OUT_DIR
# are optional.
REPO_URL=
REPO_TOKEN=
# REPO_REF=
# REPO_OUT_DIR=

# --- Web ---
# Mirror web content (a site, docs, a help center, ...) into context/ as markdown.
# WEB_URL is a start page to crawl or a sitemap URL ending in ".xml"; its host
# bounds the crawl. WEB_INCLUDE is an optional regex tested against the URL path
# (e.g. "^/docs/"). WEB_OUT_DIR and WEB_MAX_PAGES are optional.
WEB_URL=
# WEB_INCLUDE=
# WEB_OUT_DIR=
# WEB_MAX_PAGES=

# --- Zendesk Help Center ---
# Mirror a Zendesk Help Center's published articles into context/ as markdown.
# Uses the anonymous public API, so no token is required. ZENDESK_SUBDOMAIN is the
# "X" in X.zendesk.com. ZENDESK_LOCALE (Guide locale, e.g. "en-us") and
# ZENDESK_OUT_DIR are optional.
ZENDESK_SUBDOMAIN=
# ZENDESK_LOCALE=
# ZENDESK_OUT_DIR=
