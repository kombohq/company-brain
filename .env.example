# Copy this file to `.env` and fill in the values you need.
# Bun loads `.env` from the project root automatically.
#
# Each connector documents the variables it requires here as it is introduced.

# --- Notion ---
# Internal integration token (https://www.notion.com/my-integrations) with the
# "Read content" and "Read user information including email addresses"
# capabilities. Share the top-level pages/databases you want synced with it.
NOTION_TOKEN=

# --- Repository ---
# Mirror another Git repository into context/. REPO_URL is "owner/name" or a full
# clone URL. REPO_TOKEN is only needed for private repos: create a fine-grained PAT
# at https://github.com/settings/personal-access-tokens/new scoped to just the
# source repo with "Contents: Read-only" (nothing else). REPO_REF and REPO_OUT_DIR
# are optional.
REPO_URL=
REPO_TOKEN=
# REPO_REF=
# REPO_OUT_DIR=
